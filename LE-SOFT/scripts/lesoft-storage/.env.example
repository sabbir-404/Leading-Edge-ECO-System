# On the TrueNAS host, write these values to /root/lesoft-storage.env.
# NAS_JWT_SECRET must match the PostgREST JWT_SECRET (not a generated JWT).
NAS_JWT_SECRET_B64=

# Generate a dedicated 32-byte random key: openssl rand -base64 32
# Do not reuse the Postgres JWT signing secret for media encryption.
NAS_STORAGE_ENCRYPTION_KEY=

# Optional file size limit in MB (default 100).
NAS_STORAGE_MAX_FILE_MB=100
