{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "moduleResolution": "node",
        "outDir": "dist-electron",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false
    },
    "include": [
        "electron/**/*"
    ]
}